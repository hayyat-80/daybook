# --- Database (Turso) ---
DATABASE_URL=libsql://your-db-name-user.turso.io
DATABASE_AUTH_TOKEN=your_turso_token

# Shared secret for /api/* — generate with: openssl rand -hex 32
# Use the SAME value for both lines
API_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_API_SECRET=change-me-to-a-long-random-string

# Use Turso from the browser (1 = on, unset/0 = localStorage)
NEXT_PUBLIC_USE_REMOTE_DB=1

# Optional absolute API origin. Leave unset for same-origin /api.
# NEXT_PUBLIC_API_URL=http://localhost:3000
