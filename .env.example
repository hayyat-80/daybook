# --- Database (Turso) ---
DATABASE_URL=libsql://your-db-name-user.turso.io
DATABASE_AUTH_TOKEN=your_turso_token

# Signs the session cookie. Required for auth.
# Generate with: openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-string

# Allow new sign-ups after the first admin exists (1 = on). First user is always allowed and becomes admin.
# Later sign-ups always get the "user" role (not admin).
# AUTH_ALLOW_REGISTER=1

# Email that owns existing/legacy data after the user-scope migration (defaults to hayyat.fiaz080@gmail.com).
# DATA_OWNER_EMAIL=hayyat.fiaz080@gmail.com

# Optional machine access for /api/* via x-api-secret header (curl/scripts)
API_SECRET=change-me-to-a-long-random-string

# Use Turso from the browser (1 = on, unset/0 = localStorage)
NEXT_PUBLIC_USE_REMOTE_DB=1

# Optional absolute API origin. Leave unset for same-origin /api.
# NEXT_PUBLIC_API_URL=http://localhost:3000
